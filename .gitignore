# Per-machine Claude Code settings (allowlist, etc.)
.claude/settings.local.json

# Rust build output
target/

# IDE
.idea/

# macOS
.DS_Store

# wrangler's account cache and temporary bundles, written into whichever directory it runs in
.wrangler/

# Per-developer environment overrides (template.env is committed)
.env

# launchd job logs (rendered into logs/ by setup.sh)
logs/

# Rendered launchd plist (template at ingestion/eafora-ingestion.plist.template
# is the source of truth; the rendered .plist is symlinked into
# ~/Library/LaunchAgents by setup.sh)
/ingestion/eafora-ingestion.plist
