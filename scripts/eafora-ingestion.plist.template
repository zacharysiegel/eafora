<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.eafora.ingestion</string>

    <key>ProgramArguments</key>
    <array>
        <string>@@INGESTION_BIN@@</string>
        <string>all</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@@REPO_ROOT@@</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>@@LOG_DIR@@/ingestion.out.log</string>

    <key>StandardErrorPath</key>
    <string>@@LOG_DIR@@/ingestion.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
