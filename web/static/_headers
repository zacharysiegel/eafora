# Response headers for the Cloudflare Workers Assets deploy. The edge reads this file out of the deployed
# asset directory and applies its rules to asset responses. Wrangler always excludes /_headers from the
# uploaded assets, so it is never served and needs no .assetsignore entry.
#
# Matching is on request path, at most one `*` per rule, and `*` spans `/`. Where several rules match one
# request, the first rule to name a header sets it and every later rule naming it is comma-appended onto
# the value, so no two rules below name Cache-Control for the same path.
#
# Every response already carries `Cache-Control: public, max-age=0, must-revalidate`, a strong ETag over
# the file bytes, and a Content-Type looked up from the extension. Anything with no rule here keeps all
# three, which is what index.html and embedded_artifacts/manifest.json need: stable names whose bytes
# change every build, revalidated against the ETag.
#
# That extension lookup has no entry for `.fgb`, none for `.sqlite`, and returns nothing at all for a name
# with no extension. Those upload with no Content-Type header whatsoever, so the rules below state it.

/discovery
  # Extensionless, so the edge would send no Content-Type. One hour bounds how long a client keeps using
  # a superseded repository base after this document is redeployed.
  Content-Type: application/json
  Cache-Control: public, max-age=3600

/pkg/*
  # Immutable is only correct while every filename here carries a content hash, so that a rebuild changes
  # the URL. ./scripts/build/verify-site-tree.sh refuses to deploy a tree whose shell references a
  # stable-named asset, since that would pin this build's asset in caches for a year.
  Cache-Control: public, max-age=31536000, immutable

/embedded_artifacts/geometry/*
  # These bodies are brotli, encoded by the producer, and the client decodes them itself. No Content-Encoding:
  # declaring one would have the browser decode them before the client sees them, and the digest the manifest
  # carries is over the compressed bytes. Scoped to this subdirectory rather than all of embedded_artifacts
  # because these filenames carry the SHA-256 the manifest verifies, while the manifest's own name is stable.
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable

/embedded_artifacts/data/*
  # Content-hashed filenames and brotli bodies as above, so the type describes the compressed stream rather
  # than the SQLite file inside it.
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable
