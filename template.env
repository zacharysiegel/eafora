# Per-developer environment overrides. The committed `template.env` is the
# canonical reference; copy to `.env` and fill in local values.

DATABASE_URL=postgresql://localhost:5433/eafora

# Parent directory under which `ingestion build` writes per-bundle subdirectories
# (one per version label). Lives under /tmp because the bundle is content-addressed
# and re-derivable from the canonical store.
EAFORA_ARTIFACTS_DIR=/tmp/eafora/artifacts

# Default --root for `ingestion publish local` when --root is not passed
# explicitly. The local repository writes keys under this path; an external
# HTTP server is expected to serve the same path at --public-base-url.
EAFORA_LOCAL_REPOSITORY_ROOT=/tmp/eafora/repository

# Secrets bootstrap. Generate a master key with `secr key` and store it here
# base64-encoded; use the same key to populate `secrets.yaml` via `secr encrypt`.
MASTER_SECRET=
SECR_STORE_PATH=secrets.yaml

# Cloudflare R2 publish target (only required for `ingestion publish cloudflare-r2`).
R2_ACCOUNT_ID=1f389b8e0179837b349761f0b037f72a
R2_ARTIFACT_BUCKET=eafora-repository
R2_ARTIFACT_PUBLIC_BASE_URL=https://repository.eafora.org
R2_PUBLISH_ACCESS_KEY_ID=106848375888a8e16ddcf23264857e68
